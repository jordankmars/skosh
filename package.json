{
	"name": "skosh",
	"version": "0.0.0",
	"description": "",
	"keywords": [
		"react"
	],
	"homepage": "https://github.com/jordankmars/skosh#readme",
	"bugs": {
		"url": "https://github.com/jordankmars/skosh/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jordankmars/skosh.git"
	},
	"author": "Jordan Mars",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		"./react": {
			"types": "./dist/react/index.d.mts",
			"import": "./dist/react/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"playground": "vite playground",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"prepack": "pnpm build",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"packageManager": "pnpm@10.15.1",
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@biomejs/biome": "2.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"publint": "^0.3.25",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tsdown": "^0.23.7",
		"typescript": "^7.0.2",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	}
}
